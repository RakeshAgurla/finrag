# Required for `make ingest` — the SEC blocks requests without contact info.
SEC_USER_AGENT="finrag research your.email@example.com"

# hash | sentence-transformers
FINRAG_EMBEDDING_BACKEND=sentence-transformers
FINRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# cross-encoder | none
FINRAG_RERANK_BACKEND=cross-encoder

# faiss | pinecone
FINRAG_VECTOR_BACKEND=faiss
# PINECONE_API_KEY=
# PINECONE_INDEX=finrag

# anthropic | openai | echo
FINRAG_LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=
